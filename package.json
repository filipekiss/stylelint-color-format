{
  "name": "stylelint-color-format",
  "version": "1.1.0",
  "description": "Convert Hex colors to either RGBA or HSLA",
  "main": "index.js",
  "scripts": {
    "lint": "oxlint index.js rules/index.js rules/color-format/format.js rules/color-format/format.test.js",
    "test": "node rules/color-format/format.test.js",
    "precommit": "lint-staged",
    "prettier:check": "prettier '**/*.js' --list-different",
    "prettier:fix": "prettier '**/*.js' --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filipekiss/stylelint-color-format.git"
  },
  "dependencies": {
    "color": "^3.0.0",
    "style-search": "^0.1.0"
  },
  "peerDependencies": {
    "stylelint": ">=8.0.0"
  },
  "devDependencies": {
    "husky": "^0.14.3",
    "lint-staged": "^7.1.0",
    "np": "^2.20.1",
    "oxlint": "^1.35.0",
    "prettier": "^3.8.1",
    "standard-version": "^8.0.1",
    "stylelint": ">=8.0.0",
    "stylelint-test-rule-tape": "^0.2.0"
  },
  "keywords": [
    "stylelint",
    "stylelint-plugin",
    "css",
    "sass",
    "scss"
  ],
  "author": "Filipe Kiss <eu@filipekiss.com.br>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/filipekiss/stylelint-color-format/issues"
  },
  "homepage": "https://github.com/filipekiss/stylelint-color-format#readme",
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "bracketSpacing": false,
    "arrowParens": "avoid"
  },
  "lint-staged": {
    "*.js": [
      "npm test",
      "prettier --write",
      "git add"
    ]
  },
  "engines": {
    "node": ">=7"
  }
}
