{
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "style": "warn"
  },
  "rules": {
    "sort-keys": "off",
    "no-magic-numbers": "off",
    "no-ternary": "off",
    "max-lines-per-function": "off",
    "max-statements": "off",
    "capitalized-comments": "off",
    "func-names": "off"
  },
  "ignorePatterns": ["node_modules"]
}
